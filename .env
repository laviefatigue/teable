# Timezone
TIMEZONE=UTC

# Postgres Configuration
POSTGRES_HOST=teable-db
POSTGRES_PORT=5432
POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=TeableSecurePassword2024!

# Redis Configuration
REDIS_HOST=teable-cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=RedisSecurePassword2024!

# Application Configuration
# IMPORTANT: Update this to your actual Coolify domain before deployment
PUBLIC_ORIGIN=https://teable.yourdomain.com
PRISMA_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
PUBLIC_DATABASE_PROXY=teable.yourdomain.com:42345

# Cache Configuration
BACKEND_CACHE_PROVIDER=redis
BACKEND_CACHE_REDIS_URI=redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Security
SECRET_KEY=TeableJWTSecretKey2024SuperSecure!

# Email Configuration (Optional - uncomment and configure if needed)
# You need to modify the configuration according to your email provider
#BACKEND_MAIL_HOST=smtp.yourdomain.com
#BACKEND_MAIL_PORT=587
#BACKEND_MAIL_SECURE=true
#BACKEND_MAIL_SENDER=noreply@yourdomain.com
#BACKEND_MAIL_SENDER_NAME=Teable
#BACKEND_MAIL_AUTH_USER=your-email-username
#BACKEND_MAIL_AUTH_PASS=your-email-password

# Storage Configuration (Optional)
# Default is local storage, configure if using external storage
#BACKEND_STORAGE_PROVIDER=local
#BACKEND_STORAGE_LOCAL_PATH=/app/.assets

# Feature Toggles (Optional)
#RECORD_HISTORY_DISABLED=false
#PASSWORD_LOGIN_DISABLED=false

# Social Authentication (Optional)
# Uncomment and configure if using OAuth providers
#SOCIAL_AUTH_PROVIDERS=github,google
#OAUTH_GITHUB_CLIENT_ID=your-github-client-id
#OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
#OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
#OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret